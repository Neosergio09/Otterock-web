---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import MainLayout from "./MainLayout.astro";
import { useTranslatedPath } from "../i18n/utils";

interface Props {
  post: CollectionEntry<"blog">;
  lang: "es" | "en";
}

const { post, lang } = Astro.props;
const data = post.data;
const translatePath = useTranslatedPath(lang);

const labels = {
  es: { back: "← Volver al Blog", reading: "min de lectura" },
  en: { back: "← Back to Blog", reading: "min read" },
}[lang];
---

<MainLayout
  title={data.seoTitle}
  description={data.description}
  image={data.image}
  lang={lang}
  type="article"
  articleData={{
    publishedTime: data.pubDate.toISOString(),
    modifiedTime: data.updatedDate?.toISOString(),
    authorName: data.author,
    section: data.section,
    tags: data.tags,
  }}
>
  <article class="max-w-3xl mx-auto py-20 px-6">
    <header class="mb-12 text-center">
      <a
        href={translatePath("/blog")}
        class="inline-block mb-8 text-sm text-otter-stone font-bold hover:text-otter-accent transition-colors hover:underline underline-offset-4"
      >
        {labels.back}
      </a>

      <span
        class="text-otter-warm font-bold tracking-widest uppercase text-xs mb-4 block font-body"
      >
        {data.category} • {data.readingTime} {labels.reading}
      </span>

      <h1
        class="text-3xl md:text-5xl font-black text-otter-stone mb-6 leading-tight font-display"
      >
        {data.title}
      </h1>

      {
        data.quote && (
          <p class="text-xl text-otter-muted italic font-body mb-8">
            {data.quote}
          </p>
        )
      }

      <div
        class="rounded-3xl overflow-hidden shadow-xl mb-12 aspect-video bg-otter-forest"
      >
        {
          typeof data.image !== "string" ? (
            <Image
              src={data.image}
              alt={data.imageAlt}
              width={800}
              quality="mid"
              format="webp"
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover opacity-90"
            />
          ) : (
            <img
              src={data.image}
              alt={data.imageAlt}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover opacity-90"
            />
          )
        }
      </div>
    </header>

    <slot />
  </article>
</MainLayout>
