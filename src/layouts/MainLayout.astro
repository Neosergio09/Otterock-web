---
import "../styles/global.css";
import { Font } from "astro:assets";
import SEOSchema from "../components/SEOSchema.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import MagicNavbar from "../components/MagicNavbar.astro";

interface Props {
  title: string;
  lang?: "es" | "en";
  description?: string;
  // Ruta pública o imagen importada (se optimiza a 1200px para redes sociales)
  image?: string | ImageMetadata;
  // SEO Props
  type?: "website" | "article" | "profile" | "faq";
  articleData?: {
    publishedTime: string;
    modifiedTime?: string;
    authorName: string;
    section?: string;
    tags?: string[];
  };
  faqData?: {
    question: string;
    answer: string;
  }[];
}

const {
  title,
  description = "Otterock: Huellas digitales con propósito y alma",
  image = "/img/og-otterock.jpg",
  type = "website",
  articleData,
  faqData,
  lang = getLangFromUrl(Astro.url),
} = Astro.props;

const ogImage =
  typeof image === "string"
    ? image
    : (await getImage({ src: image, width: 1200, quality: 80, format: "jpg" })).src;

const { pathname } = Astro.url;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// 2. Canonical URL Limpia
const canonicalURL = new URL(pathname, Astro.site);

// Hreflang URLs
const esUrl = new URL(useTranslatedPath("es")(pathname), Astro.site);
const enUrl = new URL(useTranslatedPath("en")(pathname), Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#111615" />

    <Font cssVariable="--font-inter" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-playfair" />


    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang Tags for SEO -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />
    <meta property="og:site_name" content="Otterock" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_CO"} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.url)} />

    <meta
      name="google-site-verification"
      content="wcw-CVjPZGkhvkXszNpU0CF_6S-iSfj-lMIXmjaA-ZM"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <SEOSchema
      title={title}
      description={description}
      image={ogImage}
      type={type}
      articleData={articleData}
      faqData={faqData}
    />
  </head>

  <body class="min-h-screen flex flex-col bg-otter-deep">
    <header class="p-6 max-w-7xl mx-auto w-full flex flex-row items-center justify-between">
      <a
        href="/"
        class="text-2xl font-bold text-otter-stone hover:opacity-80 transition-opacity"
      >
        Otterock<span class="text-otter-accent">.</span>
      </a>

      <!-- Mobile Right Section (Language Picker Only) -->
      <div class="md:hidden flex items-center">
        <LanguagePicker />
      </div>

      <!-- Desktop Nav -->
      <nav
        class="hidden md:flex flex-wrap justify-center items-center gap-8 text-base font-medium text-otter-stone"
      >
        <a href={translatePath("/")} class="hover:text-otter-accent transition"
          >{t("nav.home")}
        </a>
        <a
          href={translatePath("/servicios")}
          class="hover:text-otter-accent transition"
          >{t("nav.services")}
        </a>
        <a
          href={translatePath("/portafolio")}
          class="hover:text-otter-accent transition"
          >{t("nav.portfolio")}
        </a>
        <a
          href={translatePath("/legado")}
          class="hover:text-otter-accent transition"
          >{t("nav.legacy")}
        </a>
        <a
          href={translatePath("/blog")}
          class="font-bold text-otter-stone hover:text-otter-accent transition"
          >{t("nav.blog")}
        </a>

        <div
          class="flex items-center gap-6 pl-4 border-l border-otter-stone/20 ml-2"
        >
          <LanguagePicker />

          <a
            href={translatePath("/contacto")}
            class="bg-otter-stone text-otter-deep px-6 py-2 rounded-full font-bold hover:bg-otter-accent transition-all shadow-md hover:-translate-y-0.5"
          >
            {t("nav.contact")}
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-otter-surface border-t border-otter-stone/10 text-otter-stone p-10 mt-20 mb-[100px] md:mb-0">
      <div class="max-w-7xl mx-auto text-center">
        <p class="text-lg font-medium">Otterock</p>
        <p class="text-sm opacity-80 mt-2">
          {t("footer.subtitle")}
        </p>
        <p class="text-xs opacity-80 mt-6">
          {t("footer.copyright")}
        </p>
      </div>
    </footer>

    <SpeedInsights />
    <MagicNavbar />
  </body>
</html>
