---
/**
 * Otterock Cinematic Intro v3.0 - "The Ring of Fire"
 * Efecto de aros de fuego (Carbón -> Naranja -> Amarillo) dejando el centro transparente y blanco.
 */
---

<div id="intro-overlay" class="fixed inset-0 z-[10000] flex items-center justify-center bg-white overflow-hidden">
  
  <div class="absolute inset-0 flex items-center justify-center px-6 text-center z-[1]">
    <p class="brand-message opacity-0 text-3xl md:text-5xl lg:text-6xl font-serif text-otter-deep tracking-tight leading-tight max-w-4xl">
      Construimos artesanalmente <br class="hidden md:block" /> lo que la gente siente
    </p>
  </div>

  <div id="paper-layer" class="absolute inset-0 z-[2] pointer-events-none">
    <svg class="w-full h-full" preserveAspectRatio="none">
      <defs>
        <filter id="jagged-edge">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="40" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="glow-edge">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="40" xChannelSelector="R" yChannelSelector="G" result="jagged" />
          <feGaussianBlur in="jagged" stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="jagged" />
          </feMerge>
        </filter>

        <mask id="hole-mask">
          <rect width="100%" height="100%" fill="white" />
          <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="black" filter="url(#jagged-edge)" />
        </mask>
      </defs>

      <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="none" stroke="#ffcc00" stroke-width="70" filter="url(#glow-edge)" opacity="0.9" />
      
      <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="none" stroke="#ff4d00" stroke-width="45" filter="url(#glow-edge)" opacity="0.9" />
      
      <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="none" stroke="#1a1a1a" stroke-width="15" filter="url(#jagged-edge)" />

      <rect width="100%" height="100%" fill="white" mask="url(#hole-mask)" />
    </svg>

    <div class="absolute inset-0 flex items-center justify-center" style="mask: url(#hole-mask); -webkit-mask: url(#hole-mask);">
      <h1 class="logo-text text-6xl md:text-8xl font-black text-otter-deep tracking-tighter opacity-0 scale-95 font-display">
        otterock
      </h1>
    </div>
  </div>

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

  .font-serif { font-family: 'Playfair Display', serif; }

  /* Animación de entrada del Logo */
  .logo-text {
    animation: logo-reveal 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.2s;
  }

  @keyframes logo-reveal {
    to { opacity: 1; transform: scale(1); }
  }

  /* Expansión sincronizada del hueco y los aros de fuego */
  .burn-sync {
    transition: r 4.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #intro-overlay.is-burning .burn-sync {
    r: 160vmax; /* Expande más allá de los bordes de cualquier pantalla */
  }

  /* Animación del lema que queda en el fondo blanco */
  .brand-message {
    transition: opacity 1.5s ease, transform 2s ease;
    transition-delay: 2.5s; /* Aparece mientras el aro de fuego crece */
    transform: translateY(20px);
  }

  #intro-overlay.is-burning .brand-message {
    opacity: 1;
    transform: translateY(0);
  }

  /* Desaparición suave hacia la web real */
  #intro-overlay.fade-out {
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }
</style>

<script>
  function initIntro() {
    const overlay = document.getElementById('intro-overlay');
    const body = document.body;

    if (sessionStorage.getItem('otter-intro-done') === 'true' || !overlay) {
      overlay?.remove();
      return;
    }

    body.style.overflow = 'hidden';

    // Dispara el efecto de quemado después de mostrar el logo
    setTimeout(() => {
      overlay.classList.add('is-burning');
    }, 2200);

    // Cierra la pantalla para mostrar la página web original
    setTimeout(() => {
      overlay.classList.add('fade-out');
      setTimeout(() => {
        overlay.remove();
        body.style.overflow = '';
        sessionStorage.setItem('otter-intro-done', 'true');
      }, 1000);
    }, 7500);
  }

  document.addEventListener('DOMContentLoaded', initIntro);
  document.addEventListener('astro:after-swap', initIntro);
</script>