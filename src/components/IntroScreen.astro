---
/**
 * Otterock Cinematic Intro v4.1 - "The 60fps Slow Burn"
 * Optimizaciones de GPU mantenidas. 
 * Expansión del fuego ralentizada a 7 segundos para mayor impacto visual.
 */
---

<div id="intro-overlay" class="fixed inset-0 z-[10000] flex items-center justify-center bg-white overflow-hidden">
  
  <div class="absolute inset-0 flex items-center justify-center px-6 text-center z-[1]">
    <p class="brand-message opacity-0 text-3xl md:text-5xl lg:text-6xl font-serif text-otter-deep tracking-tight leading-tight max-w-4xl will-change-transform">
      Construimos artesanalmente <br class="hidden md:block" /> lo que la gente siente
    </p>
  </div>

  <div class="absolute inset-x-0 bottom-12 flex items-center justify-center px-6 text-center z-[1]">
    <div class="brand-message opacity-0 text-lg md:text-xl font-black tracking-widest uppercase drop-shadow-sm will-change-transform">
      {(() => {
        const text = "Gracias Maria Alenjandra Catalina Del Pilar Alcazar Bello";
        const colors = ['text-blue-600', 'text-green-600', 'text-black'];
        let colorIndex = 0;
        return text.split('').map((char) => {
          if (char === ' ') return <span>&nbsp;</span>;
          const colorClass = colors[colorIndex % 3];
          colorIndex++;
          return <span class={colorClass}>{char}</span>;
        });
      })()}
    </div>
  </div>

  <div id="paper-layer" class="absolute inset-0 z-[2] pointer-events-none" style="transform: translateZ(0); will-change: transform;">
    <svg class="w-full h-full" preserveAspectRatio="none" style="transform: translateZ(0);">
      <defs>
        <filter id="jagged-edge" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="40" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <filter id="glow-edge" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="40" xChannelSelector="R" yChannelSelector="G" result="jagged" />
          <feGaussianBlur in="jagged" stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="jagged" />
          </feMerge>
        </filter>

        <mask id="hole-mask">
          <rect width="100%" height="100%" fill="white" />
          <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="black" filter="url(#jagged-edge)" />
        </mask>
      </defs>

      <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="none" stroke="#ffcc00" stroke-width="70" filter="url(#glow-edge)" opacity="0.9" style="will-change: r;" />
      <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="none" stroke="#ff4d00" stroke-width="45" filter="url(#glow-edge)" opacity="0.9" style="will-change: r;" />
      <circle class="burn-sync" cx="50%" cy="50%" r="0" fill="none" stroke="#1a1a1a" stroke-width="15" filter="url(#jagged-edge)" style="will-change: r;" />

      <rect width="100%" height="100%" fill="white" mask="url(#hole-mask)" />
    </svg>

    <div class="absolute inset-0 flex items-center justify-center" style="mask: url(#hole-mask); -webkit-mask: url(#hole-mask); transform: translateZ(0);">
      <h1 class="logo-text text-6xl md:text-8xl font-black text-otter-deep tracking-tighter opacity-0 scale-95 font-display will-change-transform">
        otterock
      </h1>
    </div>
  </div>

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

  .font-serif { font-family: 'Playfair Display', serif; }

  .logo-text {
    animation: logo-reveal 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.2s;
  }

  @keyframes logo-reveal {
    to { opacity: 1; transform: scale(1); }
  }

  /* 🔥 AJUSTE 1: Fuego ralentizado. Pasa de 4s a 7s con una curva suave (ease-in-out) */
  .burn-sync {
    transition: r 7s ease-in-out;
  }

  #intro-overlay.is-burning .burn-sync {
    r: 150vmax; 
  }

  /* ⏱️ Lema intacto. Aparece igual que en la versión anterior */
  .brand-message {
    transition: opacity 1.5s ease, transform 2s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 2.2s;
    transform: translateY(20px);
  }

  #intro-overlay.is-burning .brand-message {
    opacity: 1;
    transform: translateY(0);
  }

  #intro-overlay.fade-out {
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }
</style>

<script>
  function initIntro() {
    const overlay = document.getElementById('intro-overlay');
    const body = document.body;

    if (sessionStorage.getItem('otter-intro-done') === 'true' || !overlay) {
      overlay?.remove();
      return;
    }

    body.style.overflow = 'hidden';

    // Dispara el efecto de quemado en el segundo 2
    setTimeout(() => {
      requestAnimationFrame(() => {
        overlay.classList.add('is-burning');
      });
    }, 2000);

    // 🔥 AJUSTE 2: Extendemos la salida a 9 segundos para darle tiempo al fuego de terminar
    setTimeout(() => {
      requestAnimationFrame(() => {
        overlay.classList.add('fade-out');
      });
      setTimeout(() => {
        overlay.remove();
        body.style.overflow = '';
        sessionStorage.setItem('otter-intro-done', 'true');
      }, 800);
    }, 6000); 
  }

  document.addEventListener('DOMContentLoaded', initIntro);
  document.addEventListener('astro:after-swap', initIntro);
</script>