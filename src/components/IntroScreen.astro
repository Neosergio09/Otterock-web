---
---

<div id="intro-overlay" class="fixed inset-0 z-[10000] flex items-center justify-center bg-white overflow-hidden">
  <!-- Brand Message (Revealed behind the burning paper) -->
  <div class="absolute inset-0 flex items-center justify-center px-6 text-center pointer-events-none">
    <p class="brand-message opacity-0 text-3xl md:text-5xl lg:text-6xl font-serif text-otter-deep tracking-tight leading-tight max-w-4xl">
      Construimos artesanalmente <br class="hidden md:block" /> lo que la gente siente
    </p>
  </div>

  <!-- Burning Paper Background -->
  <div id="paper-layer" class="absolute inset-0 will-change-[filter]">
    <svg class="w-full h-full" preserveAspectRatio="none">
      <defs>
        <!-- Jagged edge filter for the burn hole -->
        <filter id="burn-edge-filter">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="5" seed="5" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="50" xChannelSelector="R" yChannelSelector="G" />
        </filter>

        <!-- Incandescent glow filter for the burning edges -->
        <filter id="ember-glow-filter" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="0" stdDeviation="15" flood-color="#ff4d00" flood-opacity="0.8" />
          <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#ff7b00" flood-opacity="0.9" />
          <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#ffcc00" />
        </filter>

        <mask id="paper-mask">
          <rect x="0" y="0" width="100%" height="100%" fill="white" />
          <circle id="burn-circle" cx="50%" cy="50%" r="0" fill="black" filter="url(#burn-edge-filter)" />
        </mask>
      </defs>

      <!-- The white paper rect with mask and ember glow -->
      <rect x="0" y="0" width="100%" height="100%" fill="white" mask="url(#paper-mask)" filter="url(#ember-glow-filter)" />
    </svg>

    <!-- Logo (Must also be masked to burn along with paper) -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" style="mask: url(#paper-mask); -webkit-mask: url(#paper-mask);">
      <h1 class="logo-text text-6xl md:text-8xl font-black text-otter-deep tracking-tighter opacity-0 scale-95">
        otterock
      </h1>
    </div>
  </div>

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

  .font-serif {
    font-family: 'Playfair Display', serif;
  }

  #paper-layer {
    mask: url(#paper-mask);
    -webkit-mask: url(#paper-mask);
  }

  /* Initial Logo Animation */
  .logo-text {
    animation: logo-fade-in 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.2s;
  }

  @keyframes logo-fade-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Burn Transition */
  #burn-circle {
    transition: r 4s cubic-bezier(0.45, 0, 0.55, 1);
    transition-delay: 2s;
  }

  #intro-overlay.is-burning #burn-circle {
    r: 150vmax;
  }

  /* Brand Message Appearance */
  .brand-message {
    transition: opacity 2s ease, transform 2s ease;
    transition-delay: 2.5s;
    transform: translateY(20px);
  }

  #intro-overlay.is-burning .brand-message {
    opacity: 1;
    transform: translateY(0);
  }

  /* Final Fade Out */
  #intro-overlay.fade-out {
    opacity: 0;
    transition: opacity 1s ease;
    pointer-events: none;
  }
</style>

<script>
  function initIntro() {
    const overlay = document.getElementById('intro-overlay');
    const body = document.body;

    // Session check
    if (sessionStorage.getItem('intro-played') === 'true') {
      if (overlay) overlay.remove();
      return;
    }

    if (!overlay) return;

    // Lock scroll
    body.style.overflow = 'hidden';

    // Start Burn Effect
    setTimeout(() => {
      overlay.classList.add('is-burning');
    }, 100); // Small initial delay to ensure DOM is ready

    // Final Fade Out and cleanup
    setTimeout(() => {
      overlay.classList.add('fade-out');
      
      setTimeout(() => {
        overlay.remove();
        body.style.overflow = '';
        sessionStorage.setItem('intro-played', 'true');
      }, 1000); // Match CSS transition duration
    }, 6000);
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', initIntro);
  // Also run on Astro view transitions if they are enabled
  document.addEventListener('astro:after-swap', initIntro);
</script>
