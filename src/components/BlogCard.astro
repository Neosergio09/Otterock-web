---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  href: string;
  readingLabel: string;
}

const { post, href, readingLabel } = Astro.props;
const { card, category, readingTime } = post.data;
---

<a
  href={href}
  class="blog-card group block opacity-0 translate-y-4 transition-all duration-700"
>
  <div
    class="relative overflow-hidden p-8 border border-otter-stone/10 rounded-[2rem] bg-otter-surface hover:border-otter-accent/40 hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)] transition-all"
  >
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <div
        class="w-full md:w-32 h-32 rounded-2xl bg-otter-deep flex items-center justify-center text-4xl group-hover:bg-otter-accent/15 transition-colors shrink-0"
      >
        {card.emoji}
      </div>

      <div class="flex-1">
        <div class="flex items-center gap-3 mb-3">
          <span
            class={`${card.badgeClass} text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full`}
            >{card.category ?? category}</span
          >
          <span class="text-otter-muted text-xs font-body"
            >{readingTime} {readingLabel}</span
          >
        </div>

        <h2
          class="text-2xl font-bold text-otter-stone group-hover:text-otter-accent transition-colors font-display mb-3"
        >
          {card.title}
        </h2>
        <p class="text-otter-muted font-body leading-relaxed text-base">
          {card.excerpt}
        </p>
      </div>

      <div class="hidden md:block self-center">
        <div
          class="w-12 h-12 rounded-full border border-otter-stone/10 flex items-center justify-center group-hover:bg-otter-stone group-hover:text-otter-deep transition-all transform group-hover:translate-x-2"
        >
          <span class="text-xl">→</span>
        </div>
      </div>
    </div>
  </div>
</a>
