---
import { Home, Layers, PawPrint, BookOpen, Mail } from 'lucide-astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pathname = Astro.url.pathname;

// 1. REORDENAMIENTO: 'Home' ahora es el tercero (el centro matemático de los 5)
const navItems = [
  { href: translatePath('/servicios'), icon: Layers, label: t("nav.services") || 'Servicios' },
  { href: translatePath('/blog'), icon: BookOpen, label: t("nav.blog") || 'Blog' },
  { href: translatePath('/'), icon: Home, label: t("nav.home") || 'Inicio' }, // <-- CENTRO
  { href: translatePath('/legado'), icon: PawPrint, label: t("nav.legacy") || 'Legado' },
  { href: translatePath('/contacto'), icon: Mail, label: t("nav.contact") || 'Contacto' },
];

const activeIndex = navItems.findIndex(item => {
  const p = pathname.replace(/\/$/, '') || '/';
  const h = item.href.replace(/\/$/, '') || '/';
  
  if (h === '/' || h === '/en') {
    return p === h;
  }
  return p === h || p.startsWith(h + '/');
});

// 2. DEFAULT AL CENTRO: Si no encuentra la ruta, la lupa descansa en el índice 2 (Inicio)
const currentIndex = activeIndex === -1 ? 2 : activeIndex;
---

<div class="fixed bottom-0 left-0 w-full flex justify-center z-50 md:hidden bg-transparent pb-6 px-4 pointer-events-none">
  <div class="navigation pointer-events-auto relative w-full max-w-[340px] h-[70px] bg-otter-deep rounded-2xl flex justify-center items-center px-2 shadow-xl border border-white/5">
    
    <div class="relative w-[300px]" style={`--active-index: ${currentIndex};`}>
      
      <div class="indicator absolute -top-[50%] left-0 w-[60px] h-[60px] bg-purple-600 rounded-full border-[6px] border-[#F5F5F4] transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] z-0 shadow-[0_8px_16px_rgba(147,51,234,0.4)]">
        <div class="before-curve absolute top-[50%] -left-[22px] w-[20px] h-[20px] bg-transparent rounded-tr-[20px] shadow-[2px_-10px_0_0_#F5F5F4]"></div>
        <div class="after-curve absolute top-[50%] -right-[22px] w-[20px] h-[20px] bg-transparent rounded-tl-[20px] shadow-[-2px_-10px_0_0_#F5F5F4]"></div>
      </div>
      
      <ul class="flex relative w-full justify-between items-center h-full">
        {navItems.map((item, index) => (
          <li class={`list relative w-[60px] h-[70px] z-10 flex-shrink-0 ${index === currentIndex ? 'active' : ''}`} data-index={index}>
            <a href={item.href} aria-label={item.label} class="relative flex justify-center items-center flex-col w-full text-center font-medium h-full">
              
              <span class="icon relative block text-2xl text-[#F5F5F4] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] flex justify-center items-center h-[70px] z-20">
                <item.icon class="w-6 h-6 stroke-[2px]" />
              </span>
              
              <span class="text absolute text-purple-700 bg-white px-2 py-0.5 rounded-full text-[10px] font-black tracking-wider opacity-0 transition-all duration-500 translate-y-5 z-10 shadow-sm uppercase">
                {item.label}
              </span>

            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .indicator {
    transform: translateX(calc(var(--active-index) * 60px));
  }

  /* 3. CENTRADO PERFECTO: Subimos a -38px para clavarlo en el medio de la burbuja */
  .list.active .icon {
    transform: translateY(-38px) scale(1.15);
    color: white; 
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
  }

  /* 4. AJUSTE DE TEXTO: Bajamos el texto a 18px para que no choque con la lupa */
  .list.active .text {
    opacity: 1;
    transform: translateY(18px);
  }
</style>