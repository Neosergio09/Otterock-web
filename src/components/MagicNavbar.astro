---
import { Home, Layers, PawPrint, BookOpen, Mail } from 'lucide-astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pathname = Astro.url.pathname;

const navItems = [
  { href: translatePath('/'), icon: Home, label: t("nav.home") || 'Home' },
  { href: translatePath('/servicios'), icon: Layers, label: t("nav.services") || 'Services' },
  { href: translatePath('/legado'), icon: PawPrint, label: t("nav.legacy") || 'Legacy' },
  { href: translatePath('/blog'), icon: BookOpen, label: t("nav.blog") || 'Blog' },
  { href: translatePath('/contacto'), icon: Mail, label: t("nav.contact") || 'Contact' },
];

const activeIndex = navItems.findIndex(item => {
  if (item.href === '/' || item.href === '/en/') {
    return pathname === item.href || pathname === item.href.slice(0, -1);
  }
  return pathname.startsWith(item.href);
});

const currentIndex = activeIndex === -1 ? 0 : activeIndex;
---

<div class="fixed bottom-0 left-0 w-full flex justify-center z-50 md:hidden bg-transparent pb-6 px-4 pointer-events-none">
  <div class="navigation pointer-events-auto relative w-full h-[70px] bg-otter-deep rounded-2xl flex justify-center items-center px-2">
    <div class="relative w-[300px]" style={`--active-index: ${currentIndex};`}>
      <div class="indicator absolute -top-[50%] left-0 w-[60px] h-[60px] bg-otter-accent rounded-full border-[6px] border-otter-sand transition-transform duration-500 ease-in-out z-0">
        <div class="before-curve absolute top-[50%] -left-[22px] w-[20px] h-[20px] bg-transparent rounded-tr-[20px] shadow-[1px_-10px_0_0_var(--color-otter-sand)]"></div>
        <div class="after-curve absolute top-[50%] -right-[22px] w-[20px] h-[20px] bg-transparent rounded-tl-[20px] shadow-[-1px_-10px_0_0_var(--color-otter-sand)]"></div>
      </div>
      
      <ul class="flex relative w-full justify-between items-center">
        {navItems.map((item, index) => (
          <li class={`list relative w-[60px] h-[70px] z-10 flex-shrink-0 ${index === currentIndex ? 'active' : ''}`} data-index={index}>
            <a href={item.href} aria-label={item.label} class="relative flex justify-center items-center flex-col w-full text-center font-medium h-full">
              <span class="icon relative block text-2xl text-otter-sand transition-transform duration-500 flex justify-center items-center h-[70px] z-20">
                <item.icon class="w-6 h-6 stroke-2" />
              </span>
              <span class="text absolute text-otter-deep bg-otter-sand px-2 py-0.5 rounded-full text-[10px] opacity-0 transition-all duration-500 translate-y-5 font-bold tracking-wider z-10">
                {item.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  :root {
    --color-otter-sand: #F5F5F4;
  }

  ul {
    padding: 0;
    margin: 0;
  }

  .indicator {
    transform: translateX(calc(var(--active-index) * 60px));
  }

  .list.active .icon {
    transform: translateY(-32px);
    color: #F5F5F4;
  }

  .list.active .text {
    opacity: 1;
    transform: translateY(12px);
  }
</style>
