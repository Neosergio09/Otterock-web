---
import { Home, Layers, Briefcase, PawPrint, BookOpen, Mail } from 'lucide-astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pathname = Astro.url.pathname;

// Mismo orden que el menú de escritorio
const navItems = [
  { href: translatePath('/'), icon: Home, label: t("nav.home") },
  { href: translatePath('/servicios'), icon: Layers, label: t("nav.services") },
  { href: translatePath('/portafolio'), icon: Briefcase, label: t("nav.portfolio") },
  { href: translatePath('/legado'), icon: PawPrint, label: t("nav.legacy") },
  { href: translatePath('/blog'), icon: BookOpen, label: t("nav.blog") },
  { href: translatePath('/contacto'), icon: Mail, label: t("nav.contact") },
];

const activeIndex = navItems.findIndex(item => {
  const p = pathname.replace(/\/$/, '') || '/';
  const h = item.href.replace(/\/$/, '') || '/';

  if (h === '/' || h === '/en') {
    return p === h;
  }
  return p === h || p.startsWith(h + '/');
});

// Si la ruta no está en el menú, la burbuja descansa en Inicio
const currentIndex = activeIndex === -1 ? 0 : activeIndex;
---

<div class="fixed bottom-0 left-0 w-full flex justify-center z-50 md:hidden bg-transparent pb-6 px-4 pointer-events-none">
  <nav aria-label="Menú principal" class="navigation pointer-events-auto relative w-full max-w-[344px] h-[70px] bg-otter-surface rounded-2xl flex justify-center items-center px-2 shadow-xl border border-otter-stone/10">

    <div class="relative w-[312px]" style={`--active-index: ${currentIndex};`}>

      <div class="indicator absolute -top-[31px] left-0 w-[52px] h-[52px] bg-otter-accent rounded-full border-[5px] border-otter-deep transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] z-0 shadow-[0_8px_16px_rgba(45,90,76,0.45)]">
        <div class="before-curve absolute top-[50%] -left-[22px] w-[20px] h-[20px] bg-transparent rounded-tr-[20px] shadow-[2px_-10px_0_0_var(--color-otter-deep)]"></div>
        <div class="after-curve absolute top-[50%] -right-[22px] w-[20px] h-[20px] bg-transparent rounded-tl-[20px] shadow-[-2px_-10px_0_0_var(--color-otter-deep)]"></div>
      </div>

      <ul class="flex relative w-full justify-between items-center h-full">
        {navItems.map((item, index) => (
          <li class={`list relative w-[52px] h-[70px] z-10 flex-shrink-0 ${index === currentIndex ? 'active' : ''}`} data-index={index}>
            <a href={item.href} aria-label={item.label} aria-current={index === activeIndex ? 'page' : undefined} class="relative flex justify-center items-center flex-col w-full text-center font-medium h-full">

              <span class="icon relative block text-otter-stone transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] flex justify-center items-center h-[70px] z-20">
                <item.icon class="w-[22px] h-[22px] stroke-[2px]" />
              </span>

              <span class="text absolute whitespace-nowrap text-otter-deep bg-otter-stone px-2 py-0.5 rounded-full text-[9px] font-black tracking-wider opacity-0 transition-all duration-500 translate-y-5 z-10 shadow-sm uppercase">
                {item.label}
              </span>

            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</div>

<style>
  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* 6 ítems de 52px: la burbuja se desplaza un ítem por posición */
  .indicator {
    transform: translateX(calc(var(--active-index) * 52px));
  }

  /* Sube el ícono activo al centro de la burbuja */
  .list.active .icon {
    transform: translateY(-40px) scale(1.1);
    color: var(--color-otter-deep);
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
  }

  .list.active .text {
    opacity: 1;
    transform: translateY(18px);
  }
</style>
