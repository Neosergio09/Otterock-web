---
interface Props {
    title: string;
    description: string;
    image: string;
    type?: "website" | "article" | "profile" | "faq";
    articleData?: {
        publishedTime: string;
        modifiedTime?: string;
        authorName: string;
        section?: string;
        tags?: string[];
    };
    faqData?: {
        question: string;
        answer: string;
    }[];
}

const {
    title,
    description,
    image,
    type = "website",
    articleData,
    faqData,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://otterock.tech";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
// Google Structured Data requiere formato PNG o JPG para el logotipo de la organización
const logoUrl = new URL("/favicon.png", siteUrl);

// 1. Base Schema - Organization / LocalBusiness
const organizationSchema: Record<string, any> = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "Otterock",
    url: siteUrl,
    email: "sergio@otterock.tech",
    logo: logoUrl.toString(),
    image: imageUrl.toString(),
    description:
        "Agencia de desarrollo web en Bogotá experta en Astro y Tailwind. Especialistas en sitios web rápidos y SEO técnico.",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Bogotá",
        addressRegion: "Cundinamarca",
        addressCountry: "CO",
    },
    priceRange: "$$",
    areaServed: {
        "@type": "City",
        name: "Bogotá",
    },
    sameAs: [
        "https://github.com/Neosergio09",
    ],
};

// 2. Article Schema
let articleSchema: Record<string, any> | null = null;
if (type === "article" && articleData) {
    articleSchema = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
            "@type": "WebPage",
            "@id": canonicalUrl.toString(),
        },
        headline: title.substring(0, 110),
        description: description,
        image: imageUrl.toString(),
        author: {
            "@type": "Person",
            name: articleData.authorName,
            url: new URL("/legado", siteUrl).toString(),
        },
        publisher: {
            "@type": "Organization",
            name: "Otterock",
            logo: {
                "@type": "ImageObject",
                url: logoUrl.toString(),
            },
        },
        datePublished: articleData.publishedTime,
        dateModified: articleData.modifiedTime || articleData.publishedTime,
        articleSection: articleData.section,
        keywords: articleData.tags?.join(", "),
    };
}

// 3. FAQ Schema
let faqSchema: Record<string, any> | null = null;
if (faqData && faqData.length > 0) {
    faqSchema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqData.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
            },
        })),
    };
}

// 4. Breadcrumb Schema (Google Rich Snippets de migas de pan)
let breadcrumbSchema: Record<string, any> | null = null;
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);

if (pathSegments.length > 0) {
    const isEn = pathSegments[0] === "en";
    const homeName = isEn ? "Home" : "Inicio";
    const homeUrl = isEn ? `${siteUrl}/en` : siteUrl;

    const itemListElement: Array<{
        "@type": string;
        position: number;
        name: string;
        item: string;
    }> = [
        {
            "@type": "ListItem",
            position: 1,
            name: homeName,
            item: homeUrl,
        },
    ];

    let accumulatedPath = isEn ? "/en" : "";
    const segmentsToProcess = isEn ? pathSegments.slice(1) : pathSegments;

    segmentsToProcess.forEach((segment) => {
        accumulatedPath += `/${segment}`;
        let name = segment;

        if (segment === "blog") {
            name = "Blog";
        } else if (segment === "servicios") {
            name = isEn ? "Services" : "Servicios";
        } else if (segment === "contacto") {
            name = isEn ? "Contact" : "Contacto";
        } else if (segment === "legado") {
            name = isEn ? "The Legacy" : "El Legado";
        } else if (segment === "posts") {
            // El segmento /posts/ intermedio se muestra como Blog
            name = "Blog";
            accumulatedPath = isEn ? "/en/blog" : "/blog";
        } else {
            // Título de la página o post limpio
            name = title.split("|")[0].trim();
        }

        // Evitar duplicar el item "Blog" si venimos de /posts/
        const alreadyExists = itemListElement.some((el) => el.item === `${siteUrl}${accumulatedPath}`);
        if (!alreadyExists) {
            itemListElement.push({
                "@type": "ListItem",
                position: itemListElement.length + 1,
                name: name,
                item: `${siteUrl}${accumulatedPath}`,
            });
        }
    });

    if (itemListElement.length > 1) {
        breadcrumbSchema = {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: itemListElement,
        };
    }
}

// Combinar todos los esquemas activos
const schemas = [organizationSchema];
if (articleSchema) schemas.push(articleSchema);
if (faqSchema) schemas.push(faqSchema);
if (breadcrumbSchema) schemas.push(breadcrumbSchema);
---

{
    schemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))
}
