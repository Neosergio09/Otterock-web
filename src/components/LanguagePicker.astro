---
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const pathname = Astro.url.pathname;
const esPath = translatePath(pathname, "es");
const enPath = translatePath(pathname, "en");
---

<div class="flex gap-2 text-sm uppercase font-bold text-otter-deep">
    <a
        href={esPath}
        class={`hover:text-otter-accent transition-colors ${
            lang === "es" ? "text-otter-accent" : ""
        }`}
    >
        ES
    </a>
    <span class="text-otter-deep/30">|</span>
    <a
        href={enPath}
        class={`hover:text-otter-accent transition-colors ${
            lang === "en" ? "text-otter-accent" : ""
        }`}
    >
        EN
    </a>
</div>
