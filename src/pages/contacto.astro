---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contacto | Otterock">
  <section class="max-w-6xl mx-auto py-20 px-6">
    <div class="grid md:grid-cols-2 gap-16">
      
      <div class="flex flex-col justify-center">
        <h2 class="text-otter-accent font-bold tracking-widest uppercase text-sm mb-4">Hablemos</h2>
        <h1 class="text-5xl font-black text-otter-deep mb-8">¿Listo para dejar tu huella?</h1>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          Cuéntanos sobre tu proyecto, tus metas y tus sueños. En Otterock, nos tomamos cada mensaje con la seriedad de un compromiso eterno. 
        </p>
        
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-otter-deep text-otter-sand rounded-full flex items-center justify-center">📍</div>
            <p class="font-medium">Bogotá, Colombia - Conexión Global</p>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-otter-deep text-otter-sand rounded-full flex items-center justify-center">✉️</div>
            <p class="font-medium">otterock11@gmail.com</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-10 rounded-[2.5rem] shadow-xl border border-otter-deep/5">
        
        <form action="https://formsubmit.co/otterock11@gmail.com" method="POST" class="space-y-6">
          
          <input type="hidden" name="_subject" value="🚀 ¡Nuevo mensaje desde la Web de Otterock!">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_template" value="table">

          <div>
            <label class="block text-sm font-bold text-otter-deep mb-2">Tu Nombre</label>
            <input 
              type="text" 
              name="nombre" 
              required 
              placeholder="Ej. Juan Pérez" 
              class="w-full px-5 py-4 rounded-2xl bg-otter-sand border-none focus:ring-2 focus:ring-otter-accent transition-all" 
            />
          </div>
          
          <div>
            <label class="block text-sm font-bold text-otter-deep mb-2">Correo Electrónico</label>
            <input 
              type="email" 
              name="email" 
              required 
              placeholder="tu@correo.com" 
              class="w-full px-5 py-4 rounded-2xl bg-otter-sand border-none focus:ring-2 focus:ring-otter-accent transition-all" 
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-otter-deep mb-2">Cuéntanos tu idea</label>
            <textarea 
              name="mensaje" 
              required 
              rows="4" 
              placeholder="¿Cómo podemos ayudarte a trascender?" 
              class="w-full px-5 py-4 rounded-2xl bg-otter-sand border-none focus:ring-2 focus:ring-otter-accent transition-all"
            ></textarea>
          </div>

          <button type="submit" class="w-full bg-otter-deep text-otter-sand py-5 rounded-2xl font-black text-lg hover:bg-otter-accent hover:-translate-y-1 transition-all shadow-lg">
            Enviar Mensaje 🐾
          </button>
        </form>
      </div>

    </div>
  </section>
</MainLayout>