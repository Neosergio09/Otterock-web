---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import blogHero from "../../assets/museo-difital.png";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";

const posts = (await getCollection("blog", (post) => post.id.startsWith("en/"))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MainLayout 
  title="Blog | Stories with Soul - Otterock"
  description="Articles, insights, and reflections on bespoke web development, modern edge architecture with Astro, technical SEO, and digital craftsmanship."
  image={blogHero.src}
>
  <section
    class="flex flex-col items-center justify-center min-h-[70vh] px-6 py-20 bg-slate-50/50"
  >
    <div class="max-w-4xl w-full text-center">
      <h1
        id="typewriter"
        class="text-3xl md:text-5xl font-mono text-otter-deep leading-relaxed min-h-[150px] mb-4"
      >
      </h1>

      <div
        id="blog-content"
        class="opacity-0 translate-y-8 transition-all duration-1000 mt-12 text-left"
      >
        <p class="text-slate-600 mb-12 italic text-xl text-center font-body">
          Stories about code, loyalty, and the digital future.
        </p>

        <!-- Main Blog Hero Image -->
        <div
          class="w-full aspect-[21/9] md:aspect-[3/1] mb-16 rounded-[2rem] overflow-hidden shadow-xl border border-otter-deep/10 bg-otter-deep/5 relative group"
        >
          <img
            src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&q=80&w=2070"
            alt="Modern Minimalist Workspace"
            class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
            loading="lazy"
          />
        </div>

        <div class="grid gap-8">
          {
            posts.map((post) => (
              <BlogCard
                post={post}
                href={`/en/posts/${post.id.replace("en/", "")}`}
                readingLabel="min read"
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    const text =
      "In the coding world, every letter tells a story... This is ours.";
    const typewriterElement = document.getElementById("typewriter");
    const contentElement = document.getElementById("blog-content");
    const cards = document.querySelectorAll(".blog-card");
    let i = 0;

    function type() {
      if (typewriterElement && i < text.length) {
        typewriterElement.innerHTML += text.charAt(i);
        i++;
        setTimeout(type, 40);
      } else {
        // Revelar contenedor principal
        contentElement?.classList.remove("opacity-0", "translate-y-8");

        // Revelar tarjetas una por una (Staggered)
        cards.forEach((card, index) => {
          setTimeout(() => {
            card.classList.remove("opacity-0", "translate-y-4");
          }, 300 * (index + 1));
        });
      }
    }

    window.onload = type;
  </script>
</MainLayout>
