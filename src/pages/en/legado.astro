---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";

// --- IMPORTACIÓN DE IMÁGENES ---
import rockoImg from "../../assets/rocko-legado.jpg";
import certIA from "../../assets/certificados/ia.png";
import certWeb from "../../assets/certificados/html.png";
---

<MainLayout title="The Legacy | Otterock">
  <section class="max-w-4xl mx-auto py-20 px-6">
    <div class="mb-16 text-center">
      <p
        class="text-otter-deep font-bold tracking-widest uppercase text-sm mb-4 font-body"
      >
        Our Essence
      </p>
      <h1
        class="text-4xl md:text-6xl font-black text-otter-deep leading-tight font-display"
      >
        Where loyalty translates into code.
      </h1>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
      <div class="space-y-6 text-lg leading-relaxed text-slate-700 font-body">
        <p>
          Otterock wasn't born in a cold office, it was born from an unbreakable
          bond. This project is dedicated to <strong class="text-otter-deep"
            >Rocko</strong
          >, my lifelong companion.
        </p>
        <p>
          Rocko was a unique soul in the body of a white Schnauzer. Over the
          years, time left its mark on him: one eye turned white with a
          cataract, a sign of nobility that only time grants.
        </p>
      </div>

      <div
        class="relative group rounded-2xl overflow-hidden shadow-2xl aspect-square bg-otter-deep"
      >
        <Image
          src={rockoImg}
          alt="Rocko, el Schnauzer blanco que inspira Otterock"
          width={800}
          quality="mid"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover object-left transition-all duration-700 group-hover:scale-110 group-hover:rotate-1"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-otter-deep/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8"
        >
          <p class="text-otter-sand font-medium italic">
            "Rocko: The soul behind every line of code."
          </p>
        </div>
      </div>
    </div>

    <div
      class="bg-white/50 border border-otter-deep/10 rounded-3xl p-10 shadow-sm mb-20"
    >
      <h2
        class="text-2xl font-bold mb-8 text-center font-display text-otter-deep"
      >
        Inspired by his journey, we promise:
      </h2>
      <div class="grid md:grid-cols-3 gap-8 font-body text-center">
        <div>
          <div class="text-otter-accent text-3xl mb-3">◈</div>
          <h3 class="font-bold mb-2 text-otter-deep">Loyalty</h3>
          <p class="text-sm text-slate-600">
            We are not just a vendor, we are your long-term technology partner.
          </p>
        </div>
        <div>
          <div class="text-otter-accent text-3xl mb-3">◈</div>
          <h3 class="font-bold mb-2 text-otter-deep">Clear Vision</h3>
          <p class="text-sm text-slate-600">
            Like Rocko's eye, we look past the surface to optimize your SEO.
          </p>
        </div>
        <div>
          <div class="text-otter-accent text-3xl mb-3">◈</div>
          <h3 class="font-bold mb-2 text-otter-deep">Solidity</h3>
          <p class="text-sm text-slate-600">
            We build websites that withstand the test of time, solid as a rock.
          </p>
        </div>
      </div>
    </div>

    <div
      class="mb-20 bg-otter-sand/40 border-2 border-dashed border-otter-accent/40 rounded-[2.5rem] p-8 md:p-12"
    >
      <div class="flex flex-col md:flex-row items-center gap-10">
        <div class="text-center md:text-left md:w-2/3">
          <span
            class="text-otter-accent font-bold tracking-tighter text-sm uppercase block mb-2"
            >🐾 Loyalty in Action</span
          >
          <h2 class="text-3xl font-black text-otter-deep mb-6 font-display">
            Our Social Footprint
          </h2>
          <p class="text-slate-700 text-lg leading-relaxed font-body">
            In honor of Rocko's loyalty, we decided that every successful
            project at <strong>Otterock</strong> must feed a hope.
            <br /><br />
            <strong
              >For every website we build, we allocate part of our profits to
              donate bags of dog food to rescued dog foundations in Bogotá.</strong
            >
            We not only deliver solid code; we deliver well-being to those who have
            no voice.
          </p>
        </div>
        <div class="md:w-1/3 flex justify-center">
          <div
            class="w-32 h-32 bg-white rounded-full flex items-center justify-center text-5xl shadow-xl border-4 border-otter-accent shadow-otter-accent/10"
          >
            🦴
          </div>
        </div>
      </div>
    </div>

    <div class="py-10">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-black text-otter-deep mb-2 font-display">
          Elite Technical Backing
        </h2>
        <p class="text-slate-600 font-body">
          Certifications that validate our ability to create modern solutions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div
          class="group overflow-hidden rounded-2xl border border-otter-deep/10 bg-white shadow-sm hover:shadow-xl transition-all duration-500"
        >
          <div class="aspect-video overflow-hidden bg-slate-100">
            <Image
              src={certIA}
              alt="Certificado Platzi IA"
              width={500}
              quality="low"
              format="webp"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-4 bg-otter-deep text-white text-center">
            <p class="font-bold text-xs tracking-widest uppercase font-body">
              IA & Machine Learning Specialist
            </p>
          </div>
        </div>

        <div
          class="group overflow-hidden rounded-2xl border border-otter-deep/10 bg-white shadow-sm hover:shadow-xl transition-all duration-500"
        >
          <div class="aspect-video overflow-hidden bg-slate-100">
            <Image
              src={certWeb}
              alt="Certificado Platzi Frontend"
              width={500}
              quality="low"
              format="webp"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-4 bg-otter-deep text-white text-center">
            <p class="font-bold text-xs tracking-widest uppercase font-body">
              Frontend Architecture Expert
            </p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-24 text-center bg-otter-deep p-12 rounded-[3rem] shadow-2xl relative overflow-hidden"
    >
      <div
        class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-3xl"
      >
      </div>
      <p class="text-otter-sand font-body italic mb-6 text-xl relative z-10">
        "Let's develop with soul and leave a mark together."
      </p>

      <a
        href="/en/contacto"
        class="inline-block bg-otter-accent text-otter-deep font-bold py-4 px-12 rounded-full hover:bg-white transition-all shadow-xl hover:-translate-y-1 font-body relative z-10"
      >
        Start my project and help
      </a>
    </div>
  </section>
</MainLayout>
