---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import blogHero from "../assets/museo-digital.jpg";
import workspaceImg from "../assets/blog-hero.jpg";
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";

const posts = (await getCollection("blog", (post) => post.id.startsWith("es/"))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MainLayout 
  title="Blog | Historias con Alma - Otterock"
  description="Artículos, análisis y reflexiones sobre desarrollo web artesanal, arquitectura moderna con Astro, SEO técnico y soberanía digital."
  image={blogHero}
>
  <section
    class="flex flex-col items-center justify-center min-h-[70vh] px-6 py-20 bg-otter-deep"
  >
    <div class="max-w-4xl w-full text-center">
      <h1
        id="typewriter"
        class="text-3xl md:text-5xl font-mono text-otter-stone leading-relaxed min-h-[150px] mb-4"
      >
      </h1>

      <div
        id="blog-content"
        class="opacity-0 translate-y-8 transition-all duration-1000 mt-12 text-left"
      >
        <p class="text-otter-muted mb-12 italic text-xl text-center font-body">
          Historias sobre código, lealtad y el futuro digital .
        </p>

        <!-- Main Blog Hero Image -->
        <div
          class="w-full aspect-[21/9] md:aspect-[3/1] mb-16 rounded-[2rem] overflow-hidden shadow-xl border border-otter-stone/10 bg-otter-stone/5 relative group"
        >
          <Image
            src={workspaceImg}
            alt="Espacio de trabajo minimalista y moderno"
            width={1200}
            quality="mid"
            format="webp"
            class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
            loading="lazy"
          />
        </div>

        <div class="grid gap-8">
          {
            posts.map((post) => (
              <BlogCard
                post={post}
                href={`/posts/${post.id.replace("es/", "")}`}
                readingLabel="min de lectura"
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    const text =
      "En el mundo del código, cada letra cuenta una historia... Esta es la nuestra.";
    const typewriterElement = document.getElementById("typewriter");
    const contentElement = document.getElementById("blog-content");
    const cards = document.querySelectorAll(".blog-card");
    let i = 0;

    function type() {
      if (typewriterElement && i < text.length) {
        typewriterElement.innerHTML += text.charAt(i);
        i++;
        setTimeout(type, 40);
      } else {
        // Revelar contenedor principal
        contentElement?.classList.remove("opacity-0", "translate-y-8");

        // Revelar tarjetas una por una (Staggered)
        cards.forEach((card, index) => {
          setTimeout(
            () => {
              card.classList.remove("opacity-0", "translate-y-4");
            },
            300 * (index + 1),
          );
        });
      }
    }

    window.onload = type;
  </script>
</MainLayout>
